---
import Arrow from '../../components/Arrow.astro';
import PageHero from '../../components/PageHero.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getContactPage, getSite } from '../../lib/content';
import { langOf, languagePaths } from '../../lib/i18n';

export const getStaticPaths = languagePaths;

const lang = langOf(Astro.url);
const { data } = await getContactPage(lang);
const { data: site } = await getSite(lang);
const email = (await getContactPage('ja')).data.email;

const rows = [
  ...(email ? [{ label: 'Email', handle: email, href: `mailto:${email}`, note: data.emailNote }] : []),
  ...data.links,
];
---

<BaseLayout
  title={data.title}
  description={data.description}
>
  <PageHero title={data.title} lead={data.lead} />

  <ul class="frame rows">
    {
      rows.map((row) => {
        const external = row.href.startsWith('http');
        return (
          <li>
            <a
              class="row link-group"
              href={row.href}
              {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
            >
              <span class="display name">{row.label}</span>
              <span class="detail">
                <span class="handle label">{row.handle}</span>
                <span class="note">{row.note}</span>
              </span>
              <Arrow />
              {external && <span class="visually-hidden">{site.ui.newTab}</span>}
            </a>
          </li>
        );
      })
    }
  </ul>
</BaseLayout>

<style>
  .rows {
    padding-block: var(--space-2xl) var(--section-gap);
  }

  .row {
    border-top: var(--rule-thin) solid var(--color-ink);
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-2xs) var(--space-md);
    position: relative;
    isolation: isolate;
    padding: var(--space-lg) 0;
    text-decoration: none;
    transition: color var(--dur-mid) var(--ease-out);
  }

  /* The inverted background sits on its own layer, so hovering never changes layout. */
  .row::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0 calc(var(--gutter) * -0.5);
    background: var(--color-ink);
    opacity: 0;
    transition: opacity var(--dur-mid) var(--ease-out);
  }

  .row:focus-visible {
    outline-offset: -3px;
  }

  .name {
    font-size: var(--text-h3);
  }

  .detail {
    grid-row: 2;
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
  }

  .handle {
    text-transform: none;
    letter-spacing: 0.04em;
    overflow-wrap: anywhere;
  }

  .note {
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .row :global(.arrow) {
    grid-column: 2;
    grid-row: 1 / span 2;
    width: 1.5rem;
    height: 1.5rem;
  }

  @media (hover: hover) {
    .row:hover {
      color: var(--color-paper);
    }

    .row:hover::before {
      opacity: 1;
    }
  }

  @media (min-width: 52rem) {
    .row {
      grid-template-columns: 11rem minmax(0, 1fr) auto;
      gap: var(--space-xl);
    }

    .detail {
      grid-row: auto;
    }

    .row :global(.arrow) {
      grid-column: 3;
      grid-row: auto;
    }
  }
</style>
