---

{
  icon ? (
    <svg class:list={['icon', { wide: icon.wide }]} viewBox={icon.viewBox ?? '0 0 24 24'} fill="currentColor" fill-rule="evenodd" aria-hidden="true">
      <path d={icon.d} />
    </svg>
  ) : (
    <Arrow />
  )
}

<style>
  .icon {
    width: 1.375rem;
    height: 1.375rem;
  }

  .wide {
    width: 2.25rem;
    height: 0.75rem;
  }
</style>
