---
interface Props {
  title: string;
  lead?: string;
}
const { title, lead } = Astro.props;
---

<section class="page-hero frame">
  <slot name="before" />
  <div class="row">
    <div class="copy">
      <div class="head">
        <h1 class="display title">{title}</h1>
        <span class="rule" data-rule aria-hidden="true"></span>
      </div>
      {lead && <p class="lead">{lead}</p>}
      <slot />
    </div>
    {
      Astro.slots.has('aside') && (
        <div class="aside" aria-hidden="true">
          <slot name="aside" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    padding-top: clamp(2rem, 4.5vw, 3.5rem);
  }

  .row {
    display: grid;
    gap: var(--space-xl);
  }

  .copy {
    display: grid;
    justify-items: start;
    gap: var(--space-md);
    min-width: 0;
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-lg);
    width: 100%;
  }

  .rule {
    flex: 1 1 3rem;
    height: var(--rule-mid);
    background: currentColor;
  }

  /* Sized from the column width, so the longest word fits on one line. */
  .title {
    font-size: min(var(--text-title), calc(var(--column-now) / var(--longest-word)));
    overflow-wrap: normal;
  }

  .lead {
    margin-top: var(--space-sm);
    font-size: var(--text-lead);
    line-height: 1.8;
  }

  .aside {
    width: 9rem;
    height: 9rem;
    overflow: clip;
  }

  @media (min-width: 40rem) {
    .row:has(.aside) {
      grid-template-columns: minmax(0, 1fr) 12rem;
      gap: var(--space-2xl);
    }

    /* The artwork and the gap take 15rem of the column. */
    .row:has(.aside) .title {
      font-size: min(var(--text-title), calc((var(--column-now) - 15rem) / var(--longest-word)));
    }

    .aside {
      width: 12rem;
      height: 12rem;
    }
  }
</style>
