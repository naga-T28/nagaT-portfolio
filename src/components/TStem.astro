---
import { T_STEM_WIDTH, tStemBars } from '../lib/logotype';

interface Props {
  /** Marks the bars so the hero can draw them in. */
  animated?: boolean;
}
const { animated = false } = Astro.props;
---

<svg class="t-stem" viewBox={`0 0 ${T_STEM_WIDTH} 10`} preserveAspectRatio="none" fill="currentColor" aria-hidden="true">
  {tStemBars.map((bar) => <rect x={bar.x} width={bar.width} height="10" {...animated ? { 'data-hero-stripe': '' } : {}} />)}
</svg>

<style>
  .t-stem {
    width: 100%;
    height: 100%;
  }
</style>
